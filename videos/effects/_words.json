{"WORDS":[{"text":"Hablemos sobre los effects en Angular.","start":0.08,"end":2},{"text":"Básicamente deberíamos tratar de evitarlos","start":2,"end":3.6},{"text":"a toda costa y Angular ha hecho mucho buen","start":3.6,"end":5.4},{"text":"trabajo para","start":5.4,"end":6.08},{"text":"mecanismos para poder evitarlos.","start":6.64,"end":8.64},{"text":"Sin embargo,","start":8.64,"end":9.04},{"text":"pues a veces hay que utilizarlos para","start":9.36,"end":10.64},{"text":"analytics, logging, debugging, manipulación","start":10.64,"end":12.52},{"text":"del DOM, etcétera.","start":12.52,"end":13.76},{"text":"Hay una forma mucho más limpia de escribir","start":13.84,"end":15.52},{"text":"estos effects a mi parecer y es con esta","start":15.52,"end":17.4},{"text":"alternativa que tiene en","start":17.4,"end":19.44},{"text":"su paquete que se llama signalMethod.","start":19.68,"end":21.76},{"text":"Tiene 3 ventajas sobre el efecto normal de","start":22.24,"end":24.08},{"text":"Angular.","start":24.08,"end":24.56},{"text":"La primera es flexible inputs.","start":24.56,"end":26},{"text":"Yo puedo enviarle un signal o simplemente","start":26,"end":28.56},{"text":"un valor","start":28.56,"end":29.12},{"text":"y él va a suscribirse y ejecutar esa lógica","start":29.36,"end":31.56},{"text":"de negocio","start":31.56,"end":32.08},{"text":"aparte como si fuera programación en la","start":32.4,"end":34.32},{"text":"entrada objetos, lo cual lo hace grande","start":34.32,"end":36},{"text":"para el unit test y tengo que pelear con el","start":36,"end":37.64},{"text":"constructor, inyectables y demás.","start":37.64,"end":39.68},{"text":"Tiene automáticamente el implicit un","start":39.68,"end":42.08},{"text":"untracked.","start":42.08,"end":42.52},{"text":"Entonces yo no me tengo que recordar cuándo","start":42.52,"end":44.52},{"text":"poner un untracked o no","start":44.52,"end":45.92},{"text":"para evitar","start":46.4,"end":47.44},{"text":"memory leaks.","start":47.68,"end":48.44},{"text":"Eso ya lo hace.","start":48.44,"end":49.28},{"text":"De por sí, eso ya","start":49.6,"end":50.32},{"text":"me ahorra un montón de pensamiento","start":50.56,"end":52.04},{"text":"cognitivo de cuándo usar un track o no.","start":52.04,"end":53.92},{"text":"Simplemente uso signalMethod y ya y se ve","start":53.92,"end":56.16},{"text":"mucho más limpio, declarativo y es","start":56.16,"end":57.92},{"text":"inyectable. Así que","start":57.92,"end":58.96},{"text":"te recomiendo usarlo si utilizas el paquete","start":59.28,"end":61.28},{"text":"de NgRx Signals.","start":61.44,"end":62.96}],"GROUPS":[{"wordStart":0,"wordEnd":0,"start":0.08,"end":2},{"wordStart":1,"wordEnd":1,"start":2,"end":3.6},{"wordStart":2,"wordEnd":2,"start":3.6,"end":5.4},{"wordStart":3,"wordEnd":3,"start":5.4,"end":6.08},{"wordStart":4,"wordEnd":4,"start":6.64,"end":8.64},{"wordStart":5,"wordEnd":5,"start":8.64,"end":9.04},{"wordStart":6,"wordEnd":6,"start":9.36,"end":10.64},{"wordStart":7,"wordEnd":7,"start":10.64,"end":12.52},{"wordStart":8,"wordEnd":8,"start":12.52,"end":13.76},{"wordStart":9,"wordEnd":9,"start":13.84,"end":15.52},{"wordStart":10,"wordEnd":10,"start":15.52,"end":17.4},{"wordStart":11,"wordEnd":11,"start":17.4,"end":19.44},{"wordStart":12,"wordEnd":12,"start":19.68,"end":21.76},{"wordStart":13,"wordEnd":13,"start":22.24,"end":24.08},{"wordStart":14,"wordEnd":14,"start":24.08,"end":24.56},{"wordStart":15,"wordEnd":15,"start":24.56,"end":26},{"wordStart":16,"wordEnd":16,"start":26,"end":28.56},{"wordStart":17,"wordEnd":17,"start":28.56,"end":29.12},{"wordStart":18,"wordEnd":18,"start":29.36,"end":31.56},{"wordStart":19,"wordEnd":19,"start":31.56,"end":32.08},{"wordStart":20,"wordEnd":20,"start":32.4,"end":34.32},{"wordStart":21,"wordEnd":21,"start":34.32,"end":36},{"wordStart":22,"wordEnd":22,"start":36,"end":37.64},{"wordStart":23,"wordEnd":23,"start":37.64,"end":39.68},{"wordStart":24,"wordEnd":24,"start":39.68,"end":42.08},{"wordStart":25,"wordEnd":25,"start":42.08,"en