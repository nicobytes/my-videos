<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=1080, height=1920">
    <style>
      @font-face { font-family: "Caveat"; src: url("fonts/Caveat-700-latin.woff2") format("woff2"); font-weight: 700; font-display: block; }
      @font-face { font-family: "Inter"; src: url("fonts/Inter-400-latin.woff2") format("woff2"); font-weight: 400; font-display: block; }
      @font-face { font-family: "Inter"; src: url("fonts/Inter-700-latin.woff2") format("woff2"); font-weight: 700; font-display: block; }

      :root {
        --bg: #fff9e3;
        --text: #1e1e1e;
        --dark: #1e1e1e;
        --dark-text: #f1f1f1;
        --blue: #1971c2;
        --red: #e03131;
        --green: #2f9e44;
        --orange: #e8590c;
        --purple: #9c36b5;
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0; padding: 0; width: 1080px; height: 1920px;
        overflow: hidden; background: #000;
        font-family: "Inter", "Caveat", ui-sans-serif, system-ui, sans-serif;
      }
      #stage { position: relative; width: 1080px; height: 1920px; overflow: hidden; }

      #video-wrap { position: absolute; left: 0; top: 0; width: 1080px; height: 1920px; overflow: hidden; }
      #bg-video { width: 1080px; height: 1920px; object-fit: cover; display: block; }

      .brush-layer { position: absolute; left: 0; top: 0; width: 1080px; height: 1920px; pointer-events: none; }

      .card-host { position: absolute; left: 0; overflow: hidden; pointer-events: none; opacity: 0; }
      .card-host.full { top: 0; width: 1080px; height: 1920px; }
      .card-host.lt { top: 1330px; width: 1080px; height: 590px; }

      /* Lower-third: paper panel over the video */
      .lt .panel {
        position: absolute; left: 60px; top: 0; width: 960px; height: 430px;
        background: rgba(255, 249, 227, 0.95); border-radius: 28px; padding: 48px 56px;
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
      }

      /* Fullscreen cards */
      .full .root { position: absolute; inset: 0; background: var(--bg); padding: 150px 80px; display: flex; flex-direction: column; }
      .full.dark .root { background: var(--dark); color: var(--dark-text); }

      .kicker { font-size: 30px; font-weight: 700; letter-spacing: 3px; color: var(--blue); text-transform: uppercase; }
      .title { font-size: 92px; font-weight: 700; line-height: 1.08; color: var(--text); margin: 18px 0 0; }
      .detail { font-size: 40px; line-height: 1.35; color: #4a4a4a; margin-top: 26px; }
      .dark .title { color: var(--dark-text); }
      .dark .detail { color: #bdbdbd; }

      .lt .title { font-size: 66px; margin-top: 14px; }
      .lt .detail { font-size: 34px; margin-top: 16px; }

      .chip {
        display: inline-block; font-size: 38px; font-weight: 700; padding: 18px 34px;
        border-radius: 999px; color: #fff; margin: 10px 8px 0 0;
      }

      .code-box {
        margin-top: 60px; background: #111; border-radius: 24px; padding: 48px 52px;
        font-family: "Consolas", "ui-monospace", monospace; font-size: 40px; line-height: 1.55;
        color: #e6e6e6; white-space: pre; position: relative;
      }
      .kw { color: #74c0fc; }
      .str { color: #8ce99a; }
      .fn { color: #ffd43b; }

      .sample-img { width: 900px; height: auto; display: block; margin-top: 60px; border-radius: 16px; box-shadow: 0 12px 36px rgba(0,0,0,0.25); }
      .hero-img { width: 720px; height: 720px; object-fit: contain; display: block; margin: 0 auto; }

      .row { display: flex; align-items: center; gap: 24px; margin-top: 40px; }
      .arrow { font-size: 72px; color: var(--text); font-weight: 700; }

      .codes { display: flex; gap: 16px; margin-top: 70px; flex-wrap: nowrap; }
      .code-pill {
        width: 150px; height: 130px; border-radius: 22px; background: #fff; border: 3px solid #d9d2b8;
        display: flex; align-items: center; justify-content: center; font-size: 56px; font-weight: 700; color: var(--text);
      }

      .timeline { position: relative; margin-top: 240px; height: 14px; background: #d9d2b8; border-radius: 7px; width: 860px; }
      .timeline .dot { position: absolute; top: -26px; width: 66px; height: 66px; border-radius: 50%; background: var(--green); }
      .timeline-label { font-size: 34px; color: var(--text); margin-top: 70px; line-height: 1.4; }
    </style>
  </head>
  <body>
    <div data-hf-id="hf-88v7" id="stage" data-composition-id="fallback-model-recut" data-start="0" data-duration="90.18" data-fps="30" data-width="1080" data-height="1920">
      <!-- Layer 1: source talking head (full frame). Hidden during fullscreen cards. -->
      <div data-hf-id="hf-qv93" id="video-wrap">
        <video data-hf-id="hf-tf1t" id="bg-video" src="input-video.mp4" playsinline data-has-audio="true" data-start="0" data-duration="90.18" data-track-index="1"></video>
      </div>

      <!-- p5.brush layers: under the cards and over them -->
      <canvas data-hf-id="hf-ytkw" id="brush-under" class="brush-layer" width="1080" height="1920" aria-hidden="true" data-layout-ignore="true" data-layout-allow-occlusion="true" style="z-index: 2; visibility: hidden"></canvas>
      <canvas data-hf-id="hf-dw9e" id="brush-over" class="brush-layer" width="1080" height="1920" aria-hidden="true" data-layout-ignore="true" data-layout-allow-occlusion="true" style="z-index: 4; visibility: hidden"></canvas>

      <!-- ── Lower-third cards (video visible behind) ── -->
      <div data-hf-id="hf-n33h" class="card-host lt clip" id="card-c01" data-card-id="c01" data-start="0" data-duration="5.0" data-track-index="2" style="z-index: 3">
        <div data-hf-id="hf-owjm" class="panel">
          <div data-hf-id="hf-pp25" class="kicker">Agentes en producción</div>
          <div data-hf-id="hf-03ur" class="title">Google se está cayendo</div>
        </div>
      </div>

      <div data-hf-id="hf-1u6s" class="card-host lt clip" id="card-c03" data-card-id="c03" data-start="12.5" data-duration="7.1" data-track-index="2" style="z-index: 3">
        <div data-hf-id="hf-gxly" class="panel">
          <div data-hf-id="hf-jmb0" class="kicker">El problema</div>
          <div data-hf-id="hf-xvc4" class="title">Mis agentes se quedan mudos</div>
          <div data-hf-id="hf-8x6t" class="detail">y los reintentos saturan más el servicio</div>
        </div>
      </div>

      <div data-hf-id="hf-9zqg" class="card-host lt clip" id="card-c05" data-card-id="c05" data-start="24.0" data-duration="6.2" data-track-index="2" style="z-index: 3">
        <div data-hf-id="hf-hbwz" class="panel">
          <div data-hf-id="hf-n18c" class="kicker">La solución</div>
          <div data-hf-id="hf-q1x0" class="row" style="margin-top: 24px">
            <span data-hf-id="hf-t47u" class="chip" style="background: var(--blue)">Primario</span>
            <span data-hf-id="hf-v68i" class="arrow">→</span>
            <span data-hf-id="hf-xedk" class="chip" style="background: var(--green)">Respaldo</span>
          </div>
          <div data-hf-id="hf-v07s" class="detail">un modelo más bajito que no esté saturado</div>
        </div>
      </div>

      <div data-hf-id="hf-6fee" class="card-host lt clip" id="card-c09" data-card-id="c09" data-start="56.0" data-duration="10.0" data-track-index="2" style="z-index: 3">
        <div data-hf-id="hf-hq80" class="panel">
          <div data-hf-id="hf-6mc8" class="kicker">Regla</div>
          <div data-hf-id="hf-tutf" class="title">Cada modelo se prueba una vez</div>
          <div data-hf-id="hf-9isl" class="detail">los reintentos viven en su propia capa</div>
        </div>
      </div>

      <!-- ── Fullscreen cards at 100% (video hidden behind) ── -->
      <div data-hf-id="hf-q9la" class="card-host full clip" id="card-c02" data-card-id="c02" data-start="5.0" data-duration="7.5" data-track-index="2" style="z-index: 3">
        <div data-hf-id="hf-iz4w" class="root">
          <div data-hf-id="hf-hhh3" class="kicker">El error que veo</div>
          <img data-hf-id="hf-vpr7" class="sample-img" src="503_error.jpeg" alt="Error 503 UNAVAILABLE en la UI de ADK">
          <div data-hf-id="hf-o09z" class="title" style="color: var(--red); margin-top: 60px">503 UNAVAILABLE</div>
          <div data-hf-id="hf-2jjm" class="detail">alta demanda · no responde directamente</div>
        </div>
      </div>

      <div data-hf-id="hf-4uwn" class="card-host full dark clip" id="card-c04" data-card-id="c04" data-start="19.6" data-duration="4.4" data-track-index="2" style="z-index: 3">
        <div data-hf-id="hf-5yn4" class="root" style="align-items: center; text-align: center">
          <img data-hf-id="hf-95ee" class="hero-img" src="hero.png" alt="" style="margin-top: 60px">
          <div data-hf-id="hf-a4r3" class="title" style="margin-top: 40px">FallbackModel</div>
          <div data-hf-id="hf-u96l" class="detail">un plan B, no un reintento</div>
        </div>
      </div>

      <div data-hf-id="hf-ossn" class="card-host full clip" id="card-c06" data-card-id="c06" data-start="30.2" data-duration="8.3" data-track-index="2" style="z-index: 3">
        <div data-hf-id="hf-zean" class="root dark-root" style="background: var(--dark); color: var(--dark-text)">
          <div data-hf-id="hf-xrpi" class="kicker" style="color: #74c0fc">Mínimo viable</div>
          <div data-hf-id="hf-rvno" class="title" style="color: var(--dark-text); font-size: 80px">Un solo cambio en tu agente</div>
          <div data-hf-id="hf-l9dn" class="code-box"><span data-hf-id="hf-n65j" class="kw">from</span> google.adk.models <span data-hf-id="hf-iusy" class="kw">import</span> <span data-hf-id="hf-zsoo" class="fn">FallbackModel</span>

agent = <span data-hf-id="hf-uahl" class="fn">LlmAgent</span>(
    model=<span data-hf-id="hf-kogg" class="fn">FallbackModel</span>(models=[
        <span data-hf-id="hf-2xj7" class="str">'gemini-3.1-pro-preview'</span>,
        <span data-hf-id="hf-d4cr" class="str">'gemini-3.5-flash'</span>,
    ]),
)</div>
        </div>
      </div>

      <div data-hf-id="hf-evev" class="card-host full clip" id="card-c07" data-card-id="c07" data-start="38.5" data-duration="7.5" data-track-index="2" style="z-index: 3">
        <div data-hf-id="hf-yjx4" class="root">
          <div data-hf-id="hf-uzjd" class="kicker">¿Cuándo cambia de modelo?</div>
          <div data-hf-id="hf-06je" class="title" style="margin-top: 14px">Solo con estos códigos</div>
          <div data-hf-id="hf-pv9y" class="codes">
            <div data-hf-id="hf-n7hg" class="code-pill" style="color: var(--red)">429</div>
            <div data-hf-id="hf-k92n" class="code-pill" style="color: var(--orange)">500</div>
            <div data-hf-id="hf-jggl" class="code-pill" style="color: var(--orange)">502</div>
            <div data-hf-id="hf-yomn" class="code-pill" style="color: var(--red)">503</div>
            <div data-hf-id="hf-t8dv" class="code-pill" style="color: var(--purple)">504</div>
          </div>
          <div data-hf-id="hf-lzah" class="detail" style="margin-top: 60px">Un error sin estado nunca cambia de modelo.</div>
        </div>
      </div>

      <div data-hf-id="hf-7zfk" class="card-host full dark clip" id="card-c08" data-card-id="c08" data-start="46.0" data-duration="10.0" data-track-index="2" style="z-index: 3">
        <div data-hf-id="hf-xd01" class="root">
          <div data-hf-id="hf-n7lc" class="kicker" style="color: #74c0fc">Personaliza la lista</div>
          <div data-hf-id="hf-3okp" class="title" style="color: var(--dark-text); font-size: 80px">Solo cambiar por rate limit</div>
          <div data-hf-id="hf-jmcm" class="code-box">FallbackModel(
    models=[<span data-hf-id="hf-lozn" class="str">'gemini-3.1-pro-preview'</span>, <span data-hf-id="hf-vmwb" class="str">'gemini-3.5-flash'</span>],
    retriable_status_codes=<span data-hf-id="hf-ou8x" class="fn">frozenset</span>({<span data-hf-id="hf-29jn" class="str">429</span>}),
)</div>
        </div>
      </div>

      <div data-hf-id="hf-tfsk" class="card-host full dark clip" id="card-c10" data-card-id="c10" data-start="66.0" data-duration="12.0" data-track-index="2" style="z-index: 3">
        <div data-hf-id="hf-xrb2" class="root">
          <div data-hf-id="hf-hpec" class="kicker" style="color: #74c0fc">Respaldo con configuración propia</div>
          <div data-hf-id="hf-opty" class="title" style="color: var(--dark-text); font-size: 80px">Entrada como instancia</div>
          <div data-hf-id="hf-mqrf" class="code-box">FallbackModel(
    models=[
        <span data-hf-id="hf-laom" class="str">'gemini-3.1-pro-preview'</span>,
        <span data-hf-id="hf-1g5q" class="fn">Gemini</span>(
            model=<span data-hf-id="hf-v8la" class="str">'gemini-3.5-flash'</span>,
            retry_options=<span data-hf-id="hf-sizl" class="fn">HttpRetryOptions</span>(attempts=<span data-hf-id="hf-mtyz" class="str">3</span>),
        ),
    ],
)</div>
        </div>
      </div>

      <div data-hf-id="hf-5h3c" class="card-host full clip" id="card-c11" data-card-id="c11" data-start="78.0" data-duration="6.0" data-track-index="2" style="z-index: 3">
        <div data-hf-id="hf-wkdz" class="root">
          <div data-hf-id="hf-zo59" class="kicker">Streaming</div>
