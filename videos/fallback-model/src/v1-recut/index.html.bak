          <div data-hf-id="hf-kte7" class="timeline-label">el turno pertenece al modelo que ya respondió</div>
        </div>
      </div>

      <div data-hf-id="hf-yvas" class="card-host full dark clip" id="card-c12" data-card-id="c12" data-start="84.0" data-duration="6.18" data-track-index="2" style="z-index: 3">
        <div data-hf-id="hf-3e1l" class="root" style="justify-content: center">
          <div data-hf-id="hf-8m3n" class="kicker" style="color: #74c0fc">Plan B</div>
          <div data-hf-id="hf-3tww" class="title" style="color: var(--dark-text); font-size: 78px">Every model is unavailable; try again.</div>
          <div data-hf-id="hf-igf4" class="detail">el agente no se queda mudo</div>
        </div>
      </div>

      <!-- Scripts: GSAP, brush engine, then the timeline -->
      <script src="vendor/gsap.min.js"></script>
      <script src="vendor/brush.js"></script>
      <script>
        window.__RECUT = {
          duration: 90.18,
          strokes: [
            // c01 — underline on the title
            { id: "c01-under", until: 5, layer: "over", kind: "path", brush: "marker", color: "#2f9e44", weight: 4,
              band: [130, 760, 1505, 3, 4], head: [1.0, 1.6] },
            // c02 — underline on the 503 headline
            { id: "c02-under", until: 12.5, layer: "over", kind: "path", brush: "marker", color: "#e03131", weight: 5,
              band: [140, 940, 812, 3, 4], head: [6.2, 6.8] },
            // c03 — underline on "mudos"
            { id: "c03-under", until: 19.6, layer: "over", kind: "path", brush: "marker", color: "#1971c2", weight: 4,
              band: [130, 700, 1505, 3, 4], head: [13.5, 14.0] },
            // c04 — underline under FallbackModel
            { id: "c04-under", until: 24, layer: "over", kind: "path", brush: "marker", color: "#2f9e44", weight: 5,
              band: [240, 840, 1060, 3, 4], head: [20.5, 21.2] },
            // c05 — underline under the Respaldo chip
            { id: "c05-under", until: 30.2, layer: "over", kind: "path", brush: "marker", color: "#2f9e44", weight: 4,
              band: [600, 960, 1512, 3, 4], head: [26.5, 27.0] },
            // c06 — highlight line in the code
            { id: "c06-under", until: 38.5, layer: "over", kind: "path", brush: "pen", color: "#74c0fc", weight: 3,
              band: [260, 800, 640, 3, 4], head: [32.0, 32.6] },
            // c07 — one highlight per status code pill
            { id: "c07-p0", until: 46, layer: "over", kind: "path", brush: "marker", color: "#e03131", weight: 6, band: [85, 225, 528, 3, 4], head: [39.2, 39.6] },
            { id: "c07-p1", until: 46, layer: "over", kind: "path", brush: "marker", color: "#e8590c", weight: 6, band: [251, 391, 528, 3, 4], head: [39.8, 40.2] },
            { id: "c07-p2", until: 46, layer: "over", kind: "path", brush: "marker", color: "#e8590c", weight: 6, band: [417, 557, 528, 3, 4], head: [40.4, 40.8] },
            { id: "c07-p3", until: 46, layer: "over", kind: "path", brush: "marker", color: "#e03131", weight: 6, band: [583, 723, 528, 3, 4], head: [41.0, 41.4] },
            { id: "c07-p4", until: 46, layer: "over", kind: "path", brush: "marker", color: "#9c36b5", weight: 6, band: [749, 889, 528, 3, 4], head: [41.6, 42.0] },
            // c08 — underline under retriable_status_codes
            { id: "c08-under", until: 56, layer: "over", kind: "path", brush: "pen", color: "#e8590c", weight: 3,
              band: [240, 920, 560, 3, 4], head: [47.5, 48.1] },
            // c10 — underline under retry_options
            { id: "c10-under", until: 78, layer: "over", kind: "path", brush: "pen", color: "#2f9e44", weight: 3,
              band: [300, 880, 730, 3, 4], head: [67.5, 68.1] },
            // c11 — timeline stroke
            { id: "c11-track", until: 84, layer: "over", kind: "path", brush: "pen", color: "#2f9e44", weight: 4,
              band: [110, 920, 752, 3, 4], head: [79.0, 80.5] },
            // c09 — underline under "una vez"
            { id: "c09-under", until: 66, layer: "over", kind: "path", brush: "marker", color: "#e03131", weight: 4,
              band: [130, 640, 1505, 3, 4], head: [57.5, 58.0] },
            // c12 — ring around the closing message
            { id: "c12-ring", until: 90.18, layer: "over", kind: "arc", brush: "charcoal", color: "#f1f1f1", weight: 3,
              arc: { x: 540, y: 960, r: 420, start: -0.9, sweep: 5.2 }, head: [86.0, 87.2] }
          ]
        };
      </script>
      <script>
/* p5.brush accent layer for fallback-model — seek-safe and deterministic.
 *
 * Engine adapted from videos/whatsapp-tips/src/brush-layer.js (p5.brush 2.2.3, MIT).
 * Strokes are data read from window.__RECUT.strokes:
 *   { id, layer, kind, brush, color, weight, pts | arc | rect, head:[t0,t1], tail?:[t2,t3], until? }
 * renderRecut(t) is a pure function of t: each stroke reseeds the RNG from its own id.
 * Drawing happens on one off-DOM WebGL2 canvas and is blitted into #brush-under and #brush-over.
 */
(function () {
  var R = window.__RECUT;
  var W = 1080, H = 1920;

  function lerp(a, b, k) { return a + (b - a) * k; }
  function clamp01(x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
  function easeInOut(x) { return x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2; }
  function prog(t, span, ease) { return span ? (ease || easeInOut)(clamp01((t - span[0]) / (span[1] - span[0]))) : 0; }
  function hash(s) { var h = 2166136261; for (var i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; }

  // Partial path by arc length: the visible segment between fractions a and b
  function segment(pts, a, b) {
    var L = [0], i;
    for (i = 1; i < pts.length; i++) L.push(L[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
    var total = L[L.length - 1];
    function at(d) {
      for (var j = 1; j < pts.length; j++) {
        if (L[j] >= d) {
          var k = (d - L[j - 1]) / (L[j] - L[j - 1] || 1);
          return [lerp(pts[j - 1][0], pts[j][0], k), lerp(pts[j - 1][1], pts[j][1], k)];
        }
      }
      return pts[pts.length - 1];
    }
    var da = a * total, db = b * total, out = [at(da)];
    for (i = 1; i < pts.length - 1; i++) if (L[i] > da && L[i] < db) out.push(pts[i]);
    out.push(at(db));
    return out;
  }

  // Visible window [a, b] of a stroke at time t, or null when it is not on screen
  function windowOf(s, t) {
    if (t < s.head[0]) return null;
    if (s.until !== undefined && t >= s.until) return null;
    if (s.tail && t >= s.tail[1]) return null;
    var b = prog(t, s.head);
    var a = s.tail ? prog(t, s.tail) : 0;
    if (b - a < 0.004) return null;
    return [a, b];
  }

  // Hand-drawn horizontal band from x0 to x1 at y (waved, not ruler-straight)
  function band(x0, x1, y, amp, n) {
    var pts = [];
    n = n || 6;
    for (var i = 0; i <= n; i++) {
      var k = i / n;
      pts.push([lerp(x0, x1, k), y + Math.sin(k * Math.PI * 2 + (hash("b" + y) % 7)) * amp]);
    }
    return pts;
  }

  var S = (R.strokes || []).map(function (s) {
    if (s.band) { s.pts = band(s.band[0], s.band[1], s.band[2], s.band[3] || 4, s.band[4] || 5); }
    return s;
  });

  function drawStroke(s, w) {
    brush.seed(hash(s.id));
    brush.noiseSeed(hash(s.id) ^ 0x9e3779b9);
    if (s.kind === "fill") {
      brush.noStroke();
      brush.fill(s.color, Math.round(s.alpha * w[1]));
      brush.fillBleed(0.18, "out");
      brush.rect(s.rect[0], s.rect[1], s.rect[2], s.rect[3]);
      brush.noFill();
      return;
    }
    brush.set(s.brush, s.color, s.weight);
    if (s.kind === "arc") {
      var c = s.arc;
      brush.arc(c.x, c.y, c.r, c.start + c.sweep * w[0], c.start + c.sweep * w[1]);
      return;
    }
    var seg = segment(s.pts, w[0], w[1]);
    if (seg.length === 2) brush.line(seg[0][0], seg[0][1], seg[1][0], seg[1][1]);
    else brush.spline(seg, 0.5);
  }

  // One off-DOM WebGL2 target, blitted into the two visible 2D layers
  var off = new OffscreenCanvas(W, H);
  brush.load(off);
  brush.scaleBrushes(4);
  var gl = off.getContext("webgl2");
  var views = {
    under: document.getElementById("brush-under").getContext("2d"),
    over: document.getElementById("brush-over").getContext("2d"),
  };
  var lastKey = { under: null, over: null };

  function renderLayer(layer, t) {
    var active = [], key = "";
    for (var i = 0; i < S.length; i++) {
      if (S[i].layer !== layer) continue;
      var w = windowOf(S[i], t);
      if (!w) continue;
      active.push([S[i], w]);
      key += S[i].id + ":" + w[0].toFixed(3) + "-" + w[1].toFixed(3) + ";";
    }
    if (key === lastKey[layer]) return;
    lastKey[layer] = key;
    var view = views[layer];
    view.clearRect(0, 0, W, H);
    view.canvas.style.visibility = active.length ? "visible" : "hidden";
    if (!active.length) return;
    brush.clear();
    gl.clearColor(0, 0, 0, 0);
    gl.clear(gl.COLOR_BUFFER_BIT);
    brush.push();
    brush.translate(-W / 2, -H / 2);
    for (var j = 0; j < active.length; j++) drawStroke(active[j][0], active[j][1]);
    brush.pop();
    brush.render();
    view.drawImage(off, 0, 0);
  }

  window.__renderRecut = function (t) {
    renderLayer("under", t);
    renderLayer("over", t);
  };
})();

</script>
      <script>
        (function () {
          var tl = gsap.timeline({ paused: true });

          // Card fades: in at start, out at end (0.3s)
          var cards = [
            ["c01", 0.0, 5.0], ["c02", 5.0, 12.5], ["c03", 12.5, 19.6], ["c04", 19.6, 24.0],
            ["c05", 24.0, 30.2], ["c06", 30.2, 38.5], ["c07", 38.5, 46.0], ["c08", 46.0, 56.0],
            ["c09", 56.0, 66.0], ["c10", 66.0, 78.0], ["c11", 78.0, 84.0], ["c12", 84.0, 90.18]
          ];
          cards.forEach(function (c) {
            var sel = '.card-host[data-card-id="' + c[0] + '"]';
            tl.fromTo(sel, { opacity: 0 }, { opacity: 1, duration: 0.3, ease: "power2.out" }, c[1]);
            tl.to(sel, { opacity: 0, duration: 0.3, ease: "power2.in" }, c[2] - 0.3);
          });

          // Video hides behind fullscreen cards, returns after them
          var full = [[5.0, 12.5], [19.6, 24.0], [30.2, 56.0], [66.0, 90.18]];
          full.forEach(function (r) {
            tl.to("#video-wrap", { opacity: 0, duration: 0.3, ease: "power2.inOut" }, r[0]);
            if (r[1] < 90.18) tl.to("#video-wrap", { opacity: 1, duration: 0.3, ease: "power2.inOut" }, r[1] - 0.3);
          });

          // Ensure the video is visible at the start and the brush layer is drawn every frame
          var clock = { t: 0 };
          tl.to(clock, { t: 90.18, duration: 90.18, ease: "none", onUpdate: function () { window.__renderRecut(clock.t); } }, 0);
          window.addEventListener("hf-seek", function (e) { window.__renderRecut(e.detail.time); });
          window.__renderRecut(0);

          window.__timelines = window.__timelines || {};
          window.__timelines["fallback-model-recut"] = tl;
        })();
      </script>
    </div>
  </body>
</html>
